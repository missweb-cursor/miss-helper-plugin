# ===== Dify Remote Debug (开发调试用) =====
INSTALL_METHOD=remote
REMOTE_INSTALL_URL=debug.dify.ai:5003
REMOTE_INSTALL_KEY=77d897e5-3df3-4f2c-aa38-25e779192ce8

# 可选：你本地/服务器的运行参数（main.py 会读取）
PORT=8000
LOG_LEVEL=info
# 可选：鉴权 Token（若你在调试阶段也想保护接口）
PUBLISH_TOKEN=change_me_in_debug

# 如使用翻译工具（translate_text），按需填写：
TRANSLATE_API_URL=
TRANSLATE_API_KEY=

# CORS 允许的来源（逗号分隔；* 表示全部）
CORS_ALLOW_ORIGINS=*