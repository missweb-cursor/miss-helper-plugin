# ===== Dify Remote Debug (开发调试用) =====
# 如需远程调试，请取消下面的注释并填入你的调试密钥
# INSTALL_METHOD=remote
# REMOTE_INSTALL_URL=debug.dify.ai:5003
# REMOTE_INSTALL_KEY=your-key-here

# ===== 服务器配置 =====
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# ===== 安全配置 =====
# API鉴权Token（生产环境必须设置）
PUBLISH_TOKEN=change_me_in_production

# ===== 翻译服务配置（可选） =====
# 如使用translate_text工具，填写LibreTranslate兼容的API
TRANSLATE_API_URL=
TRANSLATE_API_KEY=

# ===== CORS 跨域配置 =====
# 允许的来源，* 表示全部（生产环境建议指定具体域名）
CORS_ALLOW_ORIGINS=*
